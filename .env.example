# Ed25519 private key for the demo signer (base64, 32 raw bytes).
# Unset in dev = a fresh key is generated per server instance.
# In production (Vercel) set this so /keys.json is stable across instances.
# Generate one:  node -e "const ed=require('@noble/ed25519');console.log(Buffer.from(ed.utils.randomPrivateKey()).toString('base64'))"
BASIS_DEMO_SK=

# Public Rekor anchoring. Off unless this is exactly "1".
# When set, POST /api/anchor sends the full last decision record (canonical JSON,
# not a hash), the Ed25519 signature over it, and the public key to
# https://rekor.sigstore.dev. That log is append-only and public. The demo's
# records are synthetic. Leave this unset.
# BASIS_DEMO_ANCHOR=1
